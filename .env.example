# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TruthLens AI Provider Configuration
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-3.8-flash"

# Authentication & Security Configuration
JWT_SECRET="replace-with-strong-secret-in-production"
MAX_IMAGE_SIZE_MB="10"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_ANON_PER_HOUR="15"
RATE_LIMIT_AUTH_PER_HOUR="60"

# Configurable Risk Scoring Weights (Must sum to 1.0)
WEIGHT_SOURCE="0.20"
WEIGHT_CONTENT="0.20"
WEIGHT_METADATA="0.15"
WEIGHT_IMAGE="0.30"
WEIGHT_AI="0.15"
